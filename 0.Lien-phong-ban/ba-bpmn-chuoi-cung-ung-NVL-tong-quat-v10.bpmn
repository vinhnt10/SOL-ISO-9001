  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Pool" name="Quy trình tổng quát - NH đặt hàng CK, CK giao hàng" processRef="Process_1" />
    <bpmn:textAnnotation id="TextAnnotation_0yg20am">
      <bpmn:text>Hình ảnh màn hình tạo YCMH
https://senseoflife.sharepoint.com/:i:/s/15-System/IQD_yhDmktPdQ7r9njcFyCWEAS4hHLiaUX0Frmz-7IyUDao?e=bJL9u0</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_116wq97">
      <bpmn:text>Hình ảnh file Order per Milion</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0i96tuk">
      <bpmn:text>Hình ảnh màn hình CukCuk</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_07sge2g">
      <bpmn:text>Hình ảnh màn hình duyệt YCMH</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0v4c47s">
      <bpmn:text>Sau 10h, Không chỉnh sửa YCMH</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0f6jvaj">
      <bpmn:text>14h, CK bắt đầu xử lý YCMH</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1dvrd2d" associationDirection="None" sourceRef="Flow_1al6vol" targetRef="TextAnnotation_0f6jvaj" />
    <bpmn:textAnnotation id="TextAnnotation_0bqevpw">
      <bpmn:text>Màn hình
Báo cáo → Mua hàng → Tổng hợp yêu cầu từ chi nhánh.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0y9mdej">
      <bpmn:text>1. Xuất excel YCMH hợp lệ
2. Phân loại nguồn hàng cung ứng (CK hoặc chuyển Thu mua)
3. Hàng CK: phân loại theo nhóm hàng: hàng đông / hàng mát / hàng khô =&gt; để soạn hàng theo từng kho riêng, tránh sót.
4.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ccfblj">
      <bpmn:text>Thủ kho sẽ ghi tồn kho vào giấy cho Admin</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_165qaw8">
      <bpmn:text>Admin in ra danh sách sản phẩm cần soạn theo NH cho bộ phận soạn hàng</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0xbnkwg">
      <bpmn:text>Key số lượng soạn lên giấy soạn hàng gửi Admin</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1dozp8v">
      <bpmn:text>Màn hình Tạo phiếu xuất nội bộ từ YCMH</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0tk04p3">
      <bpmn:text>- CK giao 1 chuyến/ ngày bằng xe lớn theo khung giờ cố   định cho các NH trong mall: 2h–4h chiều.

- Nhân viên NH chỉ kiểm đếm và nhận hàng theo DVT của CK, không kiểm đếm chi tiết khi nhận hàng từ xe tải CK.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0zjdw0v">
      <bpmn:text>Đóng hàng vào Công/ Thùng/ Rổ để chuyển về NH
- Công (C): Các khay nhựa lớn chứa đồ.
- Thùng (T): Thường là thùng xốp (giữ lạnh) hoặc thùng carton.
- Rổ (R): Dùng để đựng các loại rau củ hoặc hàng hóa có kích thước phù hợp.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0d3mus7">
      <bpmn:text>Yêu cầu: bỏ kênh zalo/ call
Tất cả làm trên hệ thống
Áp dụng cho SOL và Nhượng quyền</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1r4mpw1">
      <bpmn:text>NH sẽ không thể nhận hàng nếu CK chưa điều chỉnh thông tin PXK</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0i6bq6h">
      <bpmn:text>Gửi ảnh chụp PO/ excel PO qua Mail/ zalo</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1g19n42">
      <bpmn:text>Hình thức giao hàng đa dạng, NCC giao bằng xe, book delivery</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1y8rzdd">
      <bpmn:text>NCC đem hàng đến tận NH, nhân viên NH sẽ không đi lấy.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1mailea">
      <bpmn:text>Theo dõi trên màn hình Xử lý nhập kho theo đơn mua</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1axn5od">
      <bpmn:text>(so sánh với ngày yêu cầu giao hàng trên F2Tech)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0f8kmj4">
      <bpmn:text>Yêu cầu bỏ kênh zalo</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1h1i0ye">
      <bpmn:text>Yêu cầu bỏ kênh zalo</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0q580w9">
      <bpmn:text>Yêu cầu bỏ kênh zalo</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0ngifr0">
      <bpmn:text>AM FC có duyệt trên CukCuk ????????</bpmn:text>
    </bpmn:textAnnotation>
