<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   targetNamespace="http://bpmn.io/schema/bpmn"
                   id="Definitions_QuyTrinhRuaTay">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Pool" name="Quy trình Rửa tay" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_NhanVien" name="Nhân viên">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Bắt đầu">
      <bpmn:documentation>Trước khi bắt đầu làm việc, sau khi đi vệ sinh, khi thay đổi khu vực chế biến, sau khi hắt hơi/ho/sổ mũi, sau khi nghe điện thoại, sau khi hút thuốc, hoặc chạm vào vật ô nhiễm.</bpmn:documentation>
      <bpmn:outgoing>Flow_Start_Task1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:manualTask id="Task_1" name="1. Làm ướt tay và thoa xà phòng">
      <bpmn:documentation>Làm ướt tay dưới vòi nước chảy, thoa xà phòng và chà xát lòng bàn tay với nhau để đảm bảo phủ kín hoàn toàn.</bpmn:documentation>
      <bpmn:incoming>Flow_Start_Task1</bpmn:incoming>
      <bpmn:outgoing>Flow_Task1_Task2</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_2" name="2. Thoa bọt xà phòng lên mu bàn tay và giữa các ngón tay">
      <bpmn:documentation>Thoa bọt xà phòng lên mu bàn tay, đảm bảo xà phòng len lỏi vào giữa các ngón tay.</bpmn:documentation>
      <bpmn:incoming>Flow_Task1_Task2</bpmn:incoming>
      <bpmn:outgoing>Flow_Task2_Task3</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_3" name="3. Chà xát các ngón tay và ngón cái">
      <bpmn:documentation>Chà xát các ngón tay trên mỗi bàn tay, đặc biệt chú ý đến ngón cái.</bpmn:documentation>
      <bpmn:incoming>Flow_Task2_Task3</bpmn:incoming>
      <bpmn:outgoing>Flow_Task3_Task4</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_4" name="4. Ấn đầu ngón tay vào lòng bàn tay">
      <bpmn:documentation>Ấn đầu ngón tay vào lòng bàn tay của mỗi tay.</bpmn:documentation>
      <bpmn:incoming>Flow_Task3_Task4</bpmn:incoming>
      <bpmn:outgoing>Flow_Task4_Task5</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_5" name="5. Lau khô tay và khử khuẩn">
      <bpmn:documentation>Lau khô tay hoàn toàn bằng khăn sạch, sau đó xịt cồn 70 độ để khử khuẩn.</bpmn:documentation>
      <bpmn:incoming>Flow_Task4_Task5</bpmn:incoming>
      <bpmn:outgoing>Flow_Task5_End</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:endEvent id="EndEvent_1" name="Hoàn tất rửa tay">
      <bpmn:incoming>Flow_Task5_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Task1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_Task1_Task2" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_Task2_Task3" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_Task3_Task4" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_Task4_Task5" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_Task5_End" sourceRef="Task_5" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Pool_di" bpmnElement="Participant_Pool" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1300" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_NhanVien_di" bpmnElement="Lane_NhanVien" isHorizontal="true">
        <dc:Bounds x="190" y="90" width="1270" height="200" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="220" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="300" y="150" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="490" y="150" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="680" y="150" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4">
        <dc:Bounds x="870" y="150" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_5_di" bpmnElement="Task_5">
        <dc:Bounds x="1060" y="150" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1250" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_Task1_di" bpmnElement="Flow_Start_Task1">
        <di:waypoint x="256" y="190" />
        <di:waypoint x="300" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task1_Task2_di" bpmnElement="Flow_Task1_Task2">
        <di:waypoint x="420" y="190" />
        <di:waypoint x="490" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task2_Task3_di" bpmnElement="Flow_Task2_Task3">
        <di:waypoint x="610" y="190" />
        <di:waypoint x="680" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task3_Task4_di" bpmnElement="Flow_Task3_Task4">
        <di:waypoint x="800" y="190" />
        <di:waypoint x="870" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task4_Task5_di" bpmnElement="Flow_Task4_Task5">
        <di:waypoint x="990" y="190" />
        <di:waypoint x="1060" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task5_End_di" bpmnElement="Flow_Task5_End">
        <di:waypoint x="1180" y="190" />
        <di:waypoint x="1250" y="190" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
