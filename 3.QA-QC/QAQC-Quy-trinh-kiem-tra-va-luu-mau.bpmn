<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   targetNamespace="http://bpmn.io/schema/bpmn"
                   id="Definitions_KiemThucLuuMau">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Pool" name="Quy trình Kiểm thực và Lưu mẫu thức ăn" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_NhanVien" name="Nhân viên lấy mẫu">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_HoanTat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_GiuMau</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Bắt đầu">
      <bpmn:outgoing>Flow_Start_Task1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:manualTask id="Task_1" name="1. Chuẩn bị nhân sự, dụng cụ và biểu mẫu">
      <bpmn:documentation>Đồng phục, khẩu trang, găng tay, mũ chùm tóc; vệ sinh và xịt khuẩn tay trước khi lấy mẫu. Hộp lưu và dụng cụ lấy mẫu đã vệ sinh + khử khuẩn. Chuẩn bị sẵn nhãn lưu mẫu thức ăn và Mẫu số 5 theo dõi lưu, hủy mẫu.</bpmn:documentation>
      <bpmn:incoming>Flow_Start_Task1</bpmn:incoming>
      <bpmn:outgoing>Flow_Task1_Task2</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_2" name="2. Lấy mẫu thức ăn theo định lượng">
      <bpmn:documentation>Lưu vào khung giờ đông khách (hơn 20 suất/lần phục vụ), trước khi phục vụ khách, lưu ngay sau khi lấy mẫu. Thực phẩm lỏng: tối thiểu 2 mẫu, ít nhất 150ml/mẫu. Thực phẩm rắn: 4 mẫu, ít nhất 100 gram/mẫu.</bpmn:documentation>
      <bpmn:incoming>Flow_Task1_Task2</bpmn:incoming>
      <bpmn:outgoing>Flow_Task2_Task3</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_3" name="3. Viết và niêm phong tem lưu mẫu">
      <bpmn:documentation>Ghi đầy đủ thông tin trên tem lưu mẫu theo biểu mẫu, niêm phong lại; ghi chép thông tin vào Mẫu số 5.</bpmn:documentation>
      <bpmn:incoming>Flow_Task2_Task3</bpmn:incoming>
      <bpmn:outgoing>Flow_Task3_Task4</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_4" name="4. Bảo quản mẫu lưu riêng biệt">
      <bpmn:documentation>Bảo quản mẫu thức ăn lưu riêng biệt với thực phẩm khác, ở nhiệt độ 2-8°C (ngăn tủ lạnh riêng hoặc tủ riêng biệt).</bpmn:documentation>
      <bpmn:incoming>Flow_Task3_Task4</bpmn:incoming>
      <bpmn:outgoing>Flow_Task4_Task5</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_5" name="5. Ghi chép vào sổ theo dõi Mẫu số 5">
      <bpmn:documentation>Ghi chép đầy đủ thông tin theo dõi và hủy mẫu lưu vào Mẫu số 5.</bpmn:documentation>
      <bpmn:incoming>Flow_Task4_Task5</bpmn:incoming>
      <bpmn:outgoing>Flow_Task5_GW1</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:exclusiveGateway id="Gateway_1" name="Sau 24 giờ, có nghi ngờ ngộ độc thực phẩm hoặc yêu cầu của cơ quan quản lý?">
      <bpmn:incoming>Flow_Task5_GW1</bpmn:incoming>
      <bpmn:outgoing>Flow_GW1_EndGiuMau</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW1_Task6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:manualTask id="Task_6" name="6. Hủy mẫu lưu tương ứng">
      <bpmn:documentation>Sau tối thiểu 24 giờ lưu mẫu, nếu không có nghi ngờ ngộ độc thực phẩm hoặc yêu cầu cụ thể của cơ quan quản lý thì tiến hành hủy mẫu lưu tương ứng.</bpmn:documentation>
      <bpmn:incoming>Flow_GW1_Task6</bpmn:incoming>
      <bpmn:outgoing>Flow_Task6_End</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:endEvent id="EndEvent_HoanTat" name="Hoàn tất">
      <bpmn:incoming>Flow_Task6_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_GiuMau" name="Giữ mẫu chờ xử lý">
      <bpmn:incoming>Flow_GW1_EndGiuMau</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Task1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_Task1_Task2" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_Task2_Task3" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_Task3_Task4" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_Task4_Task5" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_Task5_GW1" sourceRef="Task_5" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_GW1_EndGiuMau" name="Có" sourceRef="Gateway_1" targetRef="EndEvent_GiuMau" />
    <bpmn:sequenceFlow id="Flow_GW1_Task6" name="Không" sourceRef="Gateway_1" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_Task6_End" sourceRef="Task_6" targetRef="EndEvent_HoanTat" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Pool_di" bpmnElement="Participant_Pool" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1580" height="410" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_NhanVien_di" bpmnElement="Lane_NhanVien" isHorizontal="true">
        <dc:Bounds x="190" y="90" width="1550" height="380" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="200" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="280" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="470" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="660" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4">
        <dc:Bounds x="850" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_5_di" bpmnElement="Task_5">
        <dc:Bounds x="1040" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1">
        <dc:Bounds x="1230" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_GiuMau_di" bpmnElement="EndEvent_GiuMau">
        <dc:Bounds x="1330" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_6_di" bpmnElement="Task_6">
        <dc:Bounds x="1330" y="350" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_HoanTat_di" bpmnElement="EndEvent_HoanTat">
        <dc:Bounds x="1500" y="372" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_Task1_di" bpmnElement="Flow_Start_Task1">
        <di:waypoint x="236" y="240" />
        <di:waypoint x="280" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task1_Task2_di" bpmnElement="Flow_Task1_Task2">
        <di:waypoint x="400" y="240" />
        <di:waypoint x="470" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task2_Task3_di" bpmnElement="Flow_Task2_Task3">
        <di:waypoint x="590" y="240" />
        <di:waypoint x="660" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task3_Task4_di" bpmnElement="Flow_Task3_Task4">
        <di:waypoint x="780" y="240" />
        <di:waypoint x="850" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task4_Task5_di" bpmnElement="Flow_Task4_Task5">
        <di:waypoint x="970" y="240" />
        <di:waypoint x="1040" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task5_GW1_di" bpmnElement="Flow_Task5_GW1">
        <di:waypoint x="1160" y="240" />
        <di:waypoint x="1230" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GW1_EndGiuMau_di" bpmnElement="Flow_GW1_EndGiuMau">
        <di:waypoint x="1255" y="215" />
        <di:waypoint x="1255" y="118" />
        <di:waypoint x="1330" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GW1_Task6_di" bpmnElement="Flow_GW1_Task6">
        <di:waypoint x="1255" y="265" />
        <di:waypoint x="1255" y="390" />
        <di:waypoint x="1330" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task6_End_di" bpmnElement="Flow_Task6_End">
        <di:waypoint x="1450" y="390" />
        <di:waypoint x="1500" y="390" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
