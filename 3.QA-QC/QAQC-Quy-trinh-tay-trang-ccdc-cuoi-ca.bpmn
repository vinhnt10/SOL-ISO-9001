<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   targetNamespace="http://bpmn.io/schema/bpmn"
                   id="Definitions_TayTrangCCDC">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Pool" name="Quy trình Tẩy trắng CCDC cuối ca" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_NhanVien" name="Nhân viên nhà hàng">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Bắt đầu">
      <bpmn:outgoing>Flow_Start_Task1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:manualTask id="Task_1" name="1. Rửa sạch bề mặt dụng cụ">
      <bpmn:documentation>Thớt/dao: chà bằng bàn chải (4 hướng, 4 cạnh, 2 mặt) hoặc miếng bọt biển, chú ý cổ dao. Khăn/khay: giặt bằng nước rửa chén hoặc nước giặt, xả sạch. Ly (thủy tinh, sành sứ, inox): rửa sạch hoặc tráng sơ với vết bẩn nhẹ.</bpmn:documentation>
      <bpmn:incoming>Flow_Start_Task1</bpmn:incoming>
      <bpmn:outgoing>Flow_Task1_GW1</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:exclusiveGateway id="Gateway_1" name="Vết bẩn bám nặng?">
      <bpmn:incoming>Flow_Task1_GW1</bpmn:incoming>
      <bpmn:outgoing>Flow_GW1_Task2a</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW1_Task2b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:manualTask id="Task_2a" name="2. Pha loãng dung dịch tỷ lệ 50 lần">
      <bpmn:documentation>4 muỗng bột Oxygen Bleach (50gr/muỗng) + 10 lít nước ấm (60-80 độ C) — áp dụng khi vết bẩn màu bám nặng.</bpmn:documentation>
      <bpmn:incoming>Flow_GW1_Task2a</bpmn:incoming>
      <bpmn:outgoing>Flow_Task2a_Task3</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_2b" name="2. Pha loãng dung dịch tỷ lệ 100 lần">
      <bpmn:documentation>2 muỗng bột Oxygen Bleach (50gr/muỗng) + 10 lít nước ấm (60-80 độ C) — áp dụng khi vết bẩn màu bình thường.</bpmn:documentation>
      <bpmn:incoming>Flow_GW1_Task2b</bpmn:incoming>
      <bpmn:outgoing>Flow_Task2b_Task3</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_3" name="3. Ngâm dụng cụ trong dung dịch đã pha">
      <bpmn:documentation>Thớt/dao: ngâm ngập 15-30 phút tùy vết bẩn. Khăn/khay: ngâm ngập 5-10 phút. Ly: ngâm ngập 15-30 phút (cần ngâm tẩy hàng ngày do dễ bám vết màu).</bpmn:documentation>
      <bpmn:incoming>Flow_Task2a_Task3</bpmn:incoming>
      <bpmn:incoming>Flow_Task2b_Task3</bpmn:incoming>
      <bpmn:outgoing>Flow_Task3_Task4</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_4" name="4. Rửa sạch lại bằng nước">
      <bpmn:documentation>Thớt/dao: rửa sạch lại bằng nước, có thể chà cơ học thêm bằng bàn chải. Khăn: giặt lại để xả sạch dung dịch tẩy trắng Oxygen.</bpmn:documentation>
      <bpmn:incoming>Flow_Task3_Task4</bpmn:incoming>
      <bpmn:outgoing>Flow_Task4_End</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:endEvent id="EndEvent_1" name="Hoàn tất">
      <bpmn:incoming>Flow_Task4_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Task1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_Task1_GW1" sourceRef="Task_1" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_GW1_Task2a" name="Có" sourceRef="Gateway_1" targetRef="Task_2a" />
    <bpmn:sequenceFlow id="Flow_GW1_Task2b" name="Không" sourceRef="Gateway_1" targetRef="Task_2b" />
    <bpmn:sequenceFlow id="Flow_Task2a_Task3" sourceRef="Task_2a" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_Task2b_Task3" sourceRef="Task_2b" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_Task3_Task4" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_Task4_End" sourceRef="Task_4" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Pool_di" bpmnElement="Participant_Pool" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1160" height="410" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_NhanVien_di" bpmnElement="Lane_NhanVien" isHorizontal="true">
        <dc:Bounds x="190" y="90" width="1130" height="380" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="220" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="300" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1">
        <dc:Bounds x="470" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2a_di" bpmnElement="Task_2a">
        <dc:Bounds x="570" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2b_di" bpmnElement="Task_2b">
        <dc:Bounds x="570" y="350" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="740" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4">
        <dc:Bounds x="910" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1080" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_Task1_di" bpmnElement="Flow_Start_Task1">
        <di:waypoint x="256" y="240" />
        <di:waypoint x="300" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task1_GW1_di" bpmnElement="Flow_Task1_GW1">
        <di:waypoint x="420" y="240" />
        <di:waypoint x="470" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GW1_Task2a_di" bpmnElement="Flow_GW1_Task2a">
        <di:waypoint x="495" y="215" />
        <di:waypoint x="495" y="140" />
        <di:waypoint x="570" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GW1_Task2b_di" bpmnElement="Flow_GW1_Task2b">
        <di:waypoint x="495" y="265" />
        <di:waypoint x="495" y="390" />
        <di:waypoint x="570" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task2a_Task3_di" bpmnElement="Flow_Task2a_Task3">
        <di:waypoint x="690" y="140" />
        <di:waypoint x="800" y="140" />
        <di:waypoint x="800" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task2b_Task3_di" bpmnElement="Flow_Task2b_Task3">
        <di:waypoint x="690" y="390" />
        <di:waypoint x="800" y="390" />
        <di:waypoint x="800" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task3_Task4_di" bpmnElement="Flow_Task3_Task4">
        <di:waypoint x="860" y="240" />
        <di:waypoint x="910" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task4_End_di" bpmnElement="Flow_Task4_End">
        <di:waypoint x="1030" y="240" />
        <di:waypoint x="1080" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
